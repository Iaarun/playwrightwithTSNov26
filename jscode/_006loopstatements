 }
function nestedforloop3(){
    let num=5;
  for(let i=1; i<=5; i++){
    let pattern =""
    for(let j = 0; j<=num-i; j++){
        pattern += "* " // * * * * 
    }

    console.log(pattern)
  }

 }
function nestedforloop4(){
    let num=5;
  for(let i=1; i<=5; i++){
    let pattern =""
    for(let j = 1; j<=num-i; j++){
        pattern += " " // adding white space
    }
    for(let k=1; k<=i; k++){
        pattern +="*"
    }

    console.log(pattern)
  }

 }
